# Every VITE_-prefixed variable here is bundled into the browser build and is
# publicly visible - never put a secret behind this prefix.
#
# .env.local also carries VITE_TEST_A_EMAIL / VITE_TEST_A_PASSWORD /
# VITE_TEST_B_EMAIL / VITE_TEST_B_PASSWORD for the RLS isolation test suite.
# They are VITE_-prefixed only so the test tooling can read them the same way
# it reads these two - application code must never import them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
